# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave blank to run in local-only mode (data stays in this browser).
# Add the same two variables in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
