# Copy this file to .env.local and fill in the two values from your Supabase
# project: Settings → API. Leave them blank to run in local-only mode.
#
# These are also the two variables you add in Vercel:
#   Project → Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
